{
  "name": "jupyter_notebooks-tooling",
  "private": true,
  "description": "Dev tooling only (fleet gate: gitleaks, markdownlint, actionlint, notebook structure)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "gate": "FLEET_DOC_FAST=0 bash .git-hooks/pre-commit",
    "check:md": "bash scripts/lint-md.sh",
    "check:actions": "bash scripts/check-actions.sh",
    "check:notebooks": "node scripts/check-notebooks.mjs",
    "worktree:init": "npm ci"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.3"
  }
}
